# Database (PostgreSQL). Render's "postgres://" URLs are fine; they're normalized automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_cms

# JWT  (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontends
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# First admin (used by scripts/create_admin.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Uploads (leave Cloudinary blank to store files on local disk)
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form email notifications (optional; messages are always saved to the DB)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=
CONTACT_RATE_LIMIT=5